generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id          Int      @id @default(autoincrement())
  category    String
  title       String
  body        String?
  attatchment String?
  createdAt   DateTime @default(now())
  clickCount  Int      @default(0)
  author      String   @default("관리자")
}

model Visit {
  id        Int      @id @default(autoincrement())
  visitedAt DateTime @default(now())
}
